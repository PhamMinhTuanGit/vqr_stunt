  <actuator>
    <!-- Leg ctrlrange = 60 Nm, wheel = 20 Nm; finalized to match
         VQRWHEEL_CFG's actuator effort_limit (rl_training/assets/
         deeprobotics.py), which was retuned to these same values. Both sit
         between each motor's continuous and peak datasheet rating: leg motor
         SEAF70A16NG01 (rl_training/SEAF70A16NG01...pdf) lists 输出端连续堵转扭矩
         (continuous) = 16 Nm, 输出端峰值扭矩 (peak) = 96 Nm; wheel motor
         SETZ70CI-1JB (rl_training/6109611805316420072.jpg) lists 额定扭矩
         (rated) = 3 Nm, 峰值扭矩 (peak) = 24 Nm. The original continuous-rating
         caps (16/3) proved insufficient: StandUpState's classical PD climb
         from a lying-down pose (kp=80 legs) plateaued at ~28-30 deg tilt and
         never reached stand_height_, confirmed via mj_inverse + headless
         MuJoCo testing to be a genuine torque ceiling (sweeping kp up to 1000
         did NOT help; torque was capped regardless of gain). Re-verified at
         60/20: reaches z~=0.406m at only ~2 deg tilt, using at most ~23.6 Nm
         (legs) / ~4.8 Nm (wheel); comfortable margin below both caps.
         Real hardware implication: sustained operation above the continuous
         rating (16/3) risks overheating the motors; fine for the few
         seconds of a stand-up transient, not indefinite sustained load.
         OLD values, for reference/rollback: leg "-16 16" (2026-09-03
         continuous-rating retune, superseded) / "-84 84"/"-84 84"/"-150 150"
         (pre-retune); wheel "-3.0 3.0" (continuous-rating retune,
         superseded) / "-30 30" (pre-retune). -->
    <motor name="FL_HipX_joint_ctrl" joint="FL_HipX_joint" class="motor" gear="1" ctrlrange="-60 60"/>
    <motor name="FL_HipY_joint_ctrl" joint="FL_HipY_joint" class="motor" gear="1" ctrlrange="-60 60"/>
    <motor name="FL_Knee_joint_ctrl" joint="FL_Knee_joint" class="motor" gear="1" ctrlrange="-60 60"/>
    <motor name="FL_WHEEL_ctrl" joint="FL_WHEEL" class="motor" gear="1" ctrlrange="-20 20"/>
    <motor name="FR_HipX_joint_ctrl" joint="FR_HipX_joint" class="motor" gear="1" ctrlrange="-60 60"/>
    <motor name="FR_HipY_joint_ctrl" joint="FR_HipY_joint" class="motor" gear="1" ctrlrange="-60 60"/>
    <motor name="FR_Knee_joint_ctrl" joint="FR_Knee_joint" class="motor" gear="1" ctrlrange="-60 60"/>
    <motor name="FR_WHEEL_ctrl" joint="FR_WHEEL" class="motor" gear="1" ctrlrange="-20 20"/>
    <motor name="HL_HipX_joint_ctrl" joint="HL_HipX_joint" class="motor" gear="1" ctrlrange="-60 60"/>
    <motor name="HL_HipY_joint_ctrl" joint="HL_HipY_joint" class="motor" gear="1" ctrlrange="-60 60"/>
    <motor name="HL_Knee_joint_ctrl" joint="HL_Knee_joint" class="motor" gear="1" ctrlrange="-60 60"/>
    <motor name="HL_WHEEL_ctrl" joint="HL_WHEEL" class="motor" gear="1" ctrlrange="-20 20"/>
    <motor name="HR_HipX_joint_ctrl" joint="HR_HipX_joint" class="motor" gear="1" ctrlrange="-60 60"/>
    <motor name="HR_HipY_joint_ctrl" joint="HR_HipY_joint" class="motor" gear="1" ctrlrange="-60 60"/>
    <motor name="HR_Knee_joint_ctrl" joint="HR_Knee_joint" class="motor" gear="1" ctrlrange="-60 60"/>
    <motor name="HR_WHEEL_ctrl" joint="HR_WHEEL" class="motor" gear="1" ctrlrange="-20 20"/>
  </actuator>

