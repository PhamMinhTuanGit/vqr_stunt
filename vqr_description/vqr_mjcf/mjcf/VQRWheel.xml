<mujoco model="VQRWheel">
  <!--
    Hand-authored from source/rl_training's VQRWheel.urdf
    (deep_robotics_model/VQRWheel/VQRWheel_urdf/urdf/VQRWheel.urdf), following the
    same approach as VQR.xml (sibling legged robot): collision geometry is
    PRIMITIVES matching the URDF's hand-tuned <collision> shapes; visual geometry
    uses the real CAD meshes, decimated with trimesh's quadric decimation into
    vqr_description/vqr_mjcf/meshes/ (torso ~560k faces -> ~24k, over MuJoCo's
    200k-face STL decoder limit; hip/thigh/shank/wheel lightened too). Mass/inertia
    are taken verbatim from the URDF's <inertial> tags either way.

    Unlike VQR.xml, each leg ends in a continuous WHEEL joint instead of a fixed
    FOOT; no joint range/limit on the wheel hinges (this is intentional, mirrors
    the URDF's type="continuous").
  -->
  <default>
    <default class="robot">
      <default class="motor">
        <joint />
        <motor />
      </default>
      <default class="visual">
        <geom material="visualgeom" contype="0" conaffinity="0" group="2" />
      </default>
      <default class="collision">
        <geom material="collision_material" condim="3" contype="0" conaffinity="1" group="1" solref="0.005 1" friction="1 0.01 0.01" />
        <equality solimp="0.99 0.999 1e-05" solref="0.005 1" />
      </default>
    </default>
  </default>

  <compiler angle="radian" />
  <compiler autolimits="true"/>

  <asset>
    <material name="default_material" rgba="0.7 0.7 0.7 1" />
    <material name="collision_material" rgba="0.0 0.4 0.8 0.2" />
    <texture type="2d" name="checker" builtin="checker" rgb1="0.2 0.3 0.4" rgb2="0.9 0.9 0.9" width="500" height="500"/>
    <material name="checker_mat" texture="checker" specular="1" shininess="1" texrepeat="15 15"/>

    <mesh name="torso.STL" file="../meshes/torso.STL" />
    <mesh name="fl_hip.STL" file="../meshes/hip.STL" />
    <mesh name="fr_hip.STL" file="../meshes/hip.STL" scale="1 -1 1"/>
    <mesh name="hl_hip.STL" file="../meshes/hip.STL" scale="-1 1 1"/>
    <mesh name="hr_hip.STL" file="../meshes/hip.STL" scale="-1 -1 1"/>
    <mesh name="fl_thigh.STL" file="../meshes/thigh.STL" />
    <mesh name="fr_thigh.STL" file="../meshes/thigh.STL" scale="1 -1 1"/>
    <mesh name="hl_thigh.STL" file="../meshes/thigh.STL" />
    <mesh name="hr_thigh.STL" file="../meshes/thigh.STL" scale="1 -1 1"/>
    <mesh name="fl_shank.STL" file="../meshes/shank.STL" />
    <mesh name="fr_shank.STL" file="../meshes/shank.STL" scale="1 -1 1"/>
    <mesh name="hl_shank.STL" file="../meshes/shank.STL" />
    <mesh name="hr_shank.STL" file="../meshes/shank.STL" scale="1 -1 1"/>
    <mesh name="wheel.STL" file="../meshes/wheel.STL" />
  </asset>

  <worldbody>

    <geom name="floor" type="plane" size="10 10 0.1" pos="0 0 0" material="checker_mat"/>
    <light directional="true" pos="-0.5 0.5 3" dir="0 0 -1"/>

    <body name="TORSO" pos="0 0 1" quat="1 0 0 0" childclass="robot">
